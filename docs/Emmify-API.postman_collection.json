        "bearer": [{ "key": "token", "value": "{{superAdminAccessToken}}", "type": "string" }]
      },
      "item": [
        {
          "name": "Create Service Category (with services)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code < 300) {",
                  "  const json = pm.response.json();",
                  "  const data = json.data || {};",
                  "  if (data.id) pm.environment.set('serviceCategoryId', data.id);",
                  "  if (data.services && data.services[0] && data.services[0].id) {",
                  "    pm.environment.set('serviceId', data.services[0].id);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Immigration Services\",\n  \"description\": \"PR, Express Entry, Citizenship, Residency\",\n  \"services\": [\n    { \"name\": \"PR\" },\n    { \"name\": \"Express Entry\" },\n    { \"name\": \"Citizenship\" },\n    { \"name\": \"Residency\" }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/super-admin/service-categories",
              "host": ["{{baseUrl}}"],
              "path": ["super-admin", "service-categories"]
            }
          }
        },
        {
          "name": "Create Service Category (no services)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"International Services\",\n  \"description\": \"\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/super-admin/service-categories",
              "host": ["{{baseUrl}}"],
              "path": ["super-admin", "service-categories"]
            }
          }
        },
        {
          "name": "List Service Categories",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/super-admin/service-categories",
              "host": ["{{baseUrl}}"],
              "path": ["super-admin", "service-categories"]
            }
          }
        },
        {
          "name": "Get Service Category",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/super-admin/service-categories/{{serviceCategoryId}}",
              "host": ["{{baseUrl}}"],
              "path": ["super-admin", "service-categories", "{{serviceCategoryId}}"]
            }
          }
        },
        {
          "name": "Update Service Category",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Updated category description.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/super-admin/service-categories/{{serviceCategoryId}}",
              "host": ["{{baseUrl}}"],
              "path": ["super-admin", "service-categories", "{{serviceCategoryId}}"]
            }
          }
        },
        {
          "name": "Add Service to Category",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code < 300) {",
                  "  const json = pm.response.json();",
                  "  const data = json.data || {};",
                  "  if (data.id) pm.environment.set('serviceId', data.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Citizenship by Investment\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/super-admin/service-categories/{{serviceCategoryId}}/services",
              "host": ["{{baseUrl}}"],
              "path": ["super-admin", "service-categories", "{{serviceCategoryId}}", "services"]
            }
          }
        },
        {
          "name": "Update Service",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isActive\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/super-admin/services/{{serviceId}}",
              "host": ["{{baseUrl}}"],
              "path": ["super-admin", "services", "{{serviceId}}"]
            }
          }
        },
        {
          "name": "Delete Service",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/super-admin/services/{{serviceId}}",
              "host": ["{{baseUrl}}"],
              "path": ["super-admin", "services", "{{serviceId}}"]
            }
          }
        },
        {
          "name": "Delete Service Category",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/super-admin/service-categories/{{serviceCategoryId}}",
              "host": ["{{baseUrl}}"],
              "path": ["super-admin", "service-categories", "{{serviceCategoryId}}"]
            }
          }
        }
      ]
    }
