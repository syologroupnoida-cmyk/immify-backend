        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code < 300) {",
                  "  const json = pm.response.json();",
                  "  const data = json.data || {};",
                  "  if (data.accessToken) pm.environment.set('accessToken', data.accessToken);",
                  "  if (data.refreshToken) pm.environment.set('refreshToken', data.refreshToken);",
                  "  const roleMap = { SUPER_ADMIN: 'superAdminAccessToken', ADMIN: 'adminAccessToken', VENDOR: 'vendorAccessToken', CLIENT: 'clientAccessToken' };",
                  "  if (data.user && roleMap[data.user.role] && data.accessToken) {",
                  "    pm.environment.set(roleMap[data.user.role], data.accessToken);",
                  "  }",
                  "  if (data.user && data.user.id) pm.environment.set('userId', data.user.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{clientEmail}}\",\n  \"password\": \"Passw0rd123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Login (Super Admin)",
          "event": [
