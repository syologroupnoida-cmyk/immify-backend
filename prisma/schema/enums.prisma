// Shared enums used across multiple models.
// Keep enums consumed by a single model inside that model's file instead.

enum UserRole {
  SUPER_ADMIN
  ADMIN
  VENDOR
  CLIENT
}

enum EmailOtpPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  LOGIN_2FA
  AADHAAR_VERIFICATION
}

enum KycStatus {
  PENDING // Vendor signed up but has not submitted KYC yet.
  SUBMITTED // Vendor filled the KYC form; awaiting admin review.
  APPROVED // Admin approved; vendor can take work.
  REJECTED // Admin rejected; vendor must resubmit with fixes.
}

enum AuthProvider {
  LOCAL // Email + password account
  GOOGLE // Google OAuth only (no password set)
  HYBRID // Started one way, linked the other — can log in via either
}

enum CompanyType {
  PROPRIETORSHIP
  PARTNERSHIP
  LLP
  PVT_LTD
  PUBLIC_LTD
  OTHER
}

enum ReferralSource {
  REFERENCE
  GOOGLE
  SOCIAL_MEDIA
  ADVERTISEMENT
  OTHER
}

enum KycDocumentType {
  PAN
  GSTIN
  CIN
  AADHAR
  OTHER
}

// Business type for a VENDOR user. Base `UserRole` stays small (SUPER_ADMIN,
// ADMIN, VENDOR, CLIENT). What a vendor actually offers (Immigration, Visa,
// Study Abroad, ...) is captured per-vendor via ServiceCategory selection on
// their KYC — NOT here. This stays a single value unless a genuinely
// structural difference between vendor kinds shows up later (different KYC
// wizard, different dashboard, different route access).
enum VendorType {
  CONSULTANCY
}

enum LeadType {
  GLOBAL
  DIRECT
}

enum LeadStatus {
  PENDING
  VERIFIED
  ACTIVE
  REJECTED
  EXPIRED
  CLOSED
}

enum LeadPurchaseStatus {
  COMPLETED
  REFUNDED
}

enum CreditTransactionType {
  PURCHASE
  LEAD_UNLOCK
  REFUND
  ADMIN_ADJUSTMENT
  JOINING_BONUS
}

enum SubscriptionPlanStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum VendorSubscriptionStatus {
  PENDING_PAYMENT
  ACTIVE
  EXPIRED
  CANCELLED
  PAYMENT_FAILED
}

enum SubscriptionPaymentStatus {
  CREATED
  PAID
  FAILED
  REFUNDED
}

enum SubscriptionBillingPeriod {
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY
}
