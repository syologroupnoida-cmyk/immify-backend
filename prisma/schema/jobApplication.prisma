model JobApplication {
  id                   String               @id @default(uuid())
  jobListingId         String
  assignedVendorUserId String?
  firstName            String
  lastName             String
  email                String
  phone                String
  currentLocation      String?
  yearsExperience      String?
  noticePeriod         String?
  coverLetter          String?
  linkedinUrl          String?
  portfolioUrl         String?
  resumeUrl            String
  consentAt            DateTime             @default(now())
  status               JobApplicationStatus @default(SUBMITTED)
  statusNote           String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  jobListing     JobListing     @relation(fields: [jobListingId], references: [id], onDelete: Cascade)
  assignedVendor VendorProfile? @relation(fields: [assignedVendorUserId], references: [userId], onDelete: SetNull)

  @@unique([jobListingId, email])
  @@index([assignedVendorUserId, status, createdAt])
  @@index([jobListingId, createdAt])
  @@map("job_applications")
}
