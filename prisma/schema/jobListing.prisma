model JobListing {
  id                  String                 @id @default(uuid())
  vendorUserId        String?
  subscriptionId      String?
  country             String
  cityRegion          String
  title               String
  industry            String
  qualification       String?
  experience          String?
  indicativeSalary    String?
  employmentType      String
  visaWorkPermit      String?
  sourceStatus        String?
  description         String?
  responsibilities    String[]               @default([])
  requiredSkills      String[]               @default([])
  vacancyCount        Int                    @default(1)
  applicationEmail    String?
  applicationUrl      String?
  applicationDeadline DateTime?
  dynamicData         Json?
  reviewStatus        JobListingReviewStatus @default(DRAFT)
  rejectionReason     String?
  submittedAt         DateTime?
  reviewedAt          DateTime?
  reviewedByAdminId   String?
  isPublished         Boolean                @default(false)
  isVisible           Boolean                @default(false)
  publishedAt         DateTime?
  expiresAt           DateTime?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  vendor          VendorProfile?      @relation(fields: [vendorUserId], references: [userId], onDelete: SetNull)
  subscription    VendorSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  reviewedByAdmin User?               @relation("JobListingReviewer", fields: [reviewedByAdminId], references: [id], onDelete: SetNull)
  applications    JobApplication[]

  @@index([reviewStatus, submittedAt])
  @@index([isPublished, isVisible, publishedAt])
  @@index([country, cityRegion, industry])
  @@index([vendorUserId, createdAt])
  @@index([subscriptionId, reviewStatus])
  @@map("job_listings")
}
