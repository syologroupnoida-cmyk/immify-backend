model VendorCategoryOffering {
  vendorUserId String
  categoryId   String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  vendor   VendorProfile   @relation(fields: [vendorUserId], references: [userId], onDelete: Cascade)
  category ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([vendorUserId, categoryId])
  @@index([categoryId, isActive])
  @@map("vendor_category_offerings")
}

model VendorServiceOffering {
  vendorUserId     String
  serviceId        String
  isActive         Boolean  @default(true)
  isPubliclyListed Boolean  @default(false)
  title            String?
  description      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  vendor  VendorProfile @relation(fields: [vendorUserId], references: [userId], onDelete: Cascade)
  service Service       @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@id([vendorUserId, serviceId])
  @@index([serviceId, isActive])
  @@index([vendorUserId, isPubliclyListed, isActive])
  @@map("vendor_service_offerings")
}
