model VendorProfile {
  userId        String     @id
  vendorType    VendorType @default(CONSULTANCY)
  kycStatus     KycStatus  @default(PENDING)
  creditBalance Int        @default(0)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  user               User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kyc                VendorKyc?
  documents          VendorKycDocument[]
  categoryOfferings  VendorCategoryOffering[]
  serviceOfferings   VendorServiceOffering[]
  leadPurchases      LeadPurchase[]
  directLeads        Lead[]                    @relation("DirectLeadVendor")
  creditTransactions VendorCreditTransaction[]
  subscriptions      VendorSubscription[]
  serviceListings    VendorServiceListing[]
  jobListings        JobListing[]

  @@index([kycStatus])
  @@index([vendorType])
  @@map("vendor_profiles")
}
